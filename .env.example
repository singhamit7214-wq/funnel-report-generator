# ── SMTP Email Configuration ──────────────────────────────────────────
# Configure these to enable the "Send via Email" feature.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your-app-password  (use App Password, not your login password)
#   SMTP_FROM_EMAIL=your-email@gmail.com
#
# For Outlook/Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@company.com
#   SMTP_PASSWORD=your-password
#   SMTP_FROM_EMAIL=your-email@company.com
#
# For Amazon SES:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-ses-smtp-username
#   SMTP_PASSWORD=your-ses-smtp-password
#   SMTP_FROM_EMAIL=verified-sender@company.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=your-email@company.com
SMTP_FROM_NAME=Funnel Report Generator
